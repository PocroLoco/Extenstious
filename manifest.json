{
  "name": "Extensious",
  "version": "1.14.0.1",
  "manifest_version": 3,
  "description": "Quickly enable/disable Chrome extensions, and see what is in each profile. Fork of Extensity.",
  "options_page": "options.html",
  "icons" : {
    "16" : "images/icon16.png",
    "48" : "images/icon48.png",
    "128" : "images/icon128.png"
  },
  "action": {
    "default_icon": "images/iconbar.png",
    "default_title": "Extensious",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "js/migration.js"
  },
  "permissions": ["management","storage"]
}
